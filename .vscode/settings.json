{
  "files.associations": {
    "**/.dockerignore": "ignore",
    "**/.ini": "properties",
    "**/docker-compose.*.yml": "dockercompose"
  },
  "files.exclude": {
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tox/**": true,
    "**/.venv/**": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "editor.wordWrapColumn": 90,
  "editor.minimap.maxColumn": 90,
  "editor.rulers": [90],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "python.analysis.autoFormatStrings": true,
  "python.analysis.extraPaths": ["backend"],
  "flake8.cwd": "${workspaceFolder}/backend",
  "mypy.enabled": true,
  "mypy.runUsingActiveInterpreter": true,
  "mypy.configFile": "backend/pyproject.toml",
  "black-formatter.cwd": "${workspaceFolder}/backend",
  "black-formatter.args": ["--config=./pyproject.toml"],
  "black-formatter.importStrategy": "fromEnvironment",
  "isort.args": ["--settings-path", "backend/pyproject.toml"],
  "isort.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["--envfile=./../.env.test"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
