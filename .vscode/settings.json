{
  "files.associations": {
    "**/.dockerignore": "ignore",
    "**/.ini": "properties",
    "**/docker-compose.*.yml": "dockercompose"
  },
  "files.exclude": {
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tox/**": true,
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/.tanstack/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tox/**": true,
    "**/routeTree.gen.ts": true,
    "**/node_modules/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/bazel-out/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/bazel-out": true,
    "**/dist": true,
    ".history": true
  },
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.minimap.maxColumn": 150,
  "editor.rulers": [90, 150],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "python.terminal.useEnvFile": true,
  "python-envs.defaultEnvManager": "ms-python.python:poetry",
  "python-envs.defaultPackageManager": "ms-python.python:poetry",
  "python.analysis.autoFormatStrings": true,
  "python.analysis.extraPaths": ["backend"],
  "flake8.cwd": "${workspaceFolder}/backend",
  "mypy.enabled": true,
  "mypy.runUsingActiveInterpreter": true,
  "mypy.configFile": "backend/pyproject.toml",
  "black-formatter.cwd": "${workspaceFolder}/backend",
  "black-formatter.args": ["--config=./pyproject.toml"],
  "black-formatter.importStrategy": "fromEnvironment",
  "isort.args": ["--settings-path", "backend/pyproject.toml"],
  "isort.importStrategy": "fromEnvironment",
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["--envfile=./../.env.test"],
  "python.testing.pytestEnabled": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.prettier": "explicit",
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.prettier": "explicit",
      "source.fixAll.eslint": "explicit"
    }
  },
  "[html]": { "editor.wordWrap": "off" },
  "[markdown]": { "editor.wordWrap": "off" }
}
